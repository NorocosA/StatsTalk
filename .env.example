# StatsTalk configuration
# Copy this file to .env and adjust values for your machine.

# SPSS backend. Optional when STATS_BACKEND=python.
SPSS_PATH=C:\Program Files\IBM\SPSS\Statistics\29\stats.exe
SPSS_PYTHON_PATH=C:\Program Files\IBM\SPSS\Statistics\29\Python3\python.exe
SPSS_EXEC_MODE=python

# LLM endpoint. Public services must use verified HTTPS. Plain HTTP is allowed
# only for local services on localhost or 127.0.0.1.
LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Token and execution limits.
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=10000
LLM_MAX_HISTORY_ROUNDS=3
SPSS_EXECUTION_TIMEOUT=120

# Backend selection: python | spss
STATS_BACKEND=python

# Development and diagnostics.
LLM_CALL_LOG=false
LLM_MOCK=true
DEBUG=false
